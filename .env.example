# PostgreSQL
DATABASE_URL=postgresql+asyncpg://realestate:changeme@localhost:5434/realestate
DATABASE_URL_SYNC=postgresql+psycopg2://realestate:changeme@localhost:5434/realestate

# Redis
REDIS_URL=redis://localhost:6381/0

# Хранилище файлов (локальные пути)
AUDIO_STORAGE_PATH=./data/audio
RESULTS_STORAGE_PATH=./data/results

# ASR
ASR_ENGINE=assemblyai
ASSEMBLYAI_API_KEY=
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cpu

# LLM для оценки качества
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Celery
CELERY_CONCURRENCY=1

# HuggingFace (для pyannote diarization)
HF_TOKEN=

# Multi-tenant (Phase 1)
# Тенант резолвится по Host: <slug>.BASE_DOMAIN -> схема t_<slug>
BASE_DOMAIN=silentqa.com
# Слаг для Host'ов вне *.BASE_DOMAIN (локальная разработка: localhost/IP).
# Пусто = платформенный контур (apex/admin), тенантные роуты недоступны.
DEFAULT_TENANT=

# CORS: origin'ы через запятую. "*" = все (нужно расширениям/десктопу —
# их origin chrome-extension://… / file://). Сужать только вместе с
# ревизией клиентов записи.
# ALLOWED_ORIGINS=*

# Dashboard auth (Plan 2)
# SESSION_COOKIE_SECURE=false  # только для локальной http://-разработки
# ISO-дата конца grace-окна брокерских JWT без tenant-claim (деплой + 30 дней)
BROKER_JWT_TENANT_GRACE_UNTIL=
